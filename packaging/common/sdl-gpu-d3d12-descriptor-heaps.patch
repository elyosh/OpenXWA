+/* Makes sure that the bound shader-visible heaps have room for the next
+ * descriptor writes. If either heap is too full, both heaps are replaced and
+ * the function returns true. The descriptor tables that are already set then
+ * point into heaps that are no longer bound, so the caller must write all of
+ * its tables again. A full rebind of one pipeline always fits in fresh heaps. */
+static bool D3D12_INTERNAL_ReserveGPUDescriptors(
+    D3D12CommandBuffer *commandBuffer,
+    Uint32 viewDescriptorCount,
+    Uint32 samplerDescriptorCount)
+{
+    D3D12DescriptorHeap *viewHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV];
+    D3D12DescriptorHeap *samplerHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER];
+
+    if (viewHeap->currentDescriptorIndex + viewDescriptorCount <= viewHeap->maxDescriptors &&
+        samplerHeap->currentDescriptorIndex + samplerDescriptorCount <= samplerHeap->maxDescriptors) {
+        return false;
+    }
+
+    D3D12_INTERNAL_SetGPUDescriptorHeaps(commandBuffer);
+    return true;
+}
