set(bundle "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@XWA_MACOS_FIXUP_BUNDLE@")

if(NOT IS_DIRECTORY "${bundle}")
    message(FATAL_ERROR "The application bundle was not installed: ${bundle}")
endif()

include(BundleUtilities)
set(BU_CHMOD_BUNDLE_ITEMS TRUE)
fixup_bundle("${bundle}" "" "@XWA_MACOS_DEPENDENCY_DIRS@")
