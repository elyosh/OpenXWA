#include <winver.h>

IDI_ICON1 ICON "@XWA_WINDOWS_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @XWA_VERSION_MAJOR@,@XWA_VERSION_MINOR@,@XWA_VERSION_PATCH@,0
PRODUCTVERSION  @XWA_VERSION_MAJOR@,@XWA_VERSION_MINOR@,@XWA_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "OpenXWA"
            VALUE "FileVersion", "@XWA_VERSION@"
            VALUE "InternalName", "OpenXWA"
            VALUE "OriginalFilename", "OpenXWA.exe"
            VALUE "ProductName", "OpenXWA"
            VALUE "ProductVersion", "@XWA_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
